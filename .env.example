# ---- chain ----
# BSC testnet while ERC-8183 mainnet is pending. Confirm judging target with organizers.
BENCH_CHAIN=bsc-testnet
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
BSC_MAINNET_RPC_URL=https://bsc-dataseed.bnbchain.org

# Archive node for the shadow engine. A pruned node CANNOT serve historical
# fork state, so audition windows will silently fail without this.
BSC_ARCHIVE_RPC_URL=

# ---- ERC-8004 registries (singleton deployments) ----
ERC8004_IDENTITY_REGISTRY=
ERC8004_REPUTATION_REGISTRY=
ERC8004_VALIDATION_REGISTRY=

# ---- ERC-8183 agentic commerce ----
ERC8183_AGENTIC_COMMERCE=
ERC8183_EVALUATOR_ROUTER=

# ---- x402 ----
X402_FACILITATOR_URL=
# eip3009 | permit2-exact | permit2-upto  (use permit2-upto for metered agents)
X402_DEFAULT_SCHEME=permit2-upto
X402_SETTLEMENT_TOKEN=USDT

# ---- wallet ----
# evm-local | twak | altana   (altana is the only one with EIP-7702 session keys)
BENCH_WALLET_PROVIDER=evm-local
BENCH_SIGNER_PRIVATE_KEY=
ALTANA_API_KEY=

# ---- infra ----
DATABASE_URL=postgresql://bench:bench@localhost:5432/bench
REDIS_URL=redis://localhost:6379

# ---- shadow engine safety ----
# Hard ceiling on real money a single audition may spend on outbound x402 data
# calls. A shadowed agent still makes REAL outbound requests. Without this a
# hundred auditions can bill you for real. See ARCHITECTURE.md 3.3.
SHADOW_EGRESS_BUDGET_USD=0.25
SHADOW_EGRESS_ALLOWLIST=
SHADOW_MAX_CONCURRENT_FORKS=4

# ---- integrations ----
ALTLAYER_8004SCAN_API_KEY=
