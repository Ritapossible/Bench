# ---- chain ----
# BSC testnet while ERC-8183 mainnet is pending. Confirm judging target with organizers.
BENCH_CHAIN=bsc-testnet
# Verified reachable 29 Aug 2026. data-seed-prebsc-1-s1 is dead; publicnode
# serves logs but prunes them after ~11 hours, which is why discovery walks
# token ids instead of scanning registration events.
BSC_TESTNET_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
BSC_MAINNET_RPC_URL=https://bsc-dataseed.bnbchain.org

# The chain auditions FORK, which is not the chain agents register on.
# Identity is on testnet (the mainnet ERC-8004 proxy is an unactivated stub
# with zero agents); markets are on mainnet. An audition replays market
# history, so it forks mainnet and drives agents registered on testnet.
SHADOW_FORK_CHAIN=bsc-mainnet
# Archive node for the shadow engine, and it must serve SHADOW_FORK_CHAIN -
# the worker checks eth_chainId at boot rather than trusting it. A pruned node
# CANNOT serve historical fork state; test a candidate with eth_getStorageAt at
# a block ~200k back, not eth_getCode, which some pruned nodes still answer.
# Optional: without it the worker still indexes and probes, and says on startup
# that auditions are off. With it, the audition queue runs.
BSC_ARCHIVE_RPC_URL=

# ---- ERC-8004 registries (singleton deployments) ----
# BSC testnet (chain 97). Verified on chain: name()="AgentIdentity",
# symbol()="AGENT", 2,013 agents minted since Feb 2026.
ERC8004_IDENTITY_REGISTRY=0x8004a818bfb912233c491871b3d84c89a494bd9e
ERC8004_REPUTATION_REGISTRY=
# Optional. Only probe-digest anchoring uses it, and anchoring also needs
# BENCH_SIGNER_PRIVATE_KEY; without both, the anchor queue stays unregistered
# and the UI says liveness is not yet anchored rather than claiming it is.
ERC8004_VALIDATION_REGISTRY=
# Only used by the log-scanning path. Discovery walks token ids instead, which
# needs no block range at all - see Indexer.enumerationTick.
ERC8004_REGISTRY_START_BLOCK=88400902

# ---- ERC-8183 agentic commerce ----
ERC8183_AGENTIC_COMMERCE=
ERC8183_EVALUATOR_ROUTER=

# ---- x402 ----
X402_FACILITATOR_URL=
# eip3009 | permit2-exact | permit2-upto  (use permit2-upto for metered agents)
X402_DEFAULT_SCHEME=permit2-upto
X402_SETTLEMENT_TOKEN=USDT

# ---- wallet ----
# evm-local | twak | altana   (altana is the only one with EIP-7702 session keys)
BENCH_WALLET_PROVIDER=evm-local
BENCH_SIGNER_PRIVATE_KEY=
ALTANA_API_KEY=

# ---- infra ----
DATABASE_URL=postgresql://bench:bench@localhost:5432/bench
REDIS_URL=redis://localhost:6379

# ---- shadow engine safety ----
# Hard ceiling on real money a single audition may spend on outbound x402 data
# calls. A shadowed agent still makes REAL outbound requests. Without this a
# hundred auditions can bill you for real. See ARCHITECTURE.md 3.3.
SHADOW_EGRESS_BUDGET_USD=0.25
SHADOW_EGRESS_ALLOWLIST=
SHADOW_MAX_CONCURRENT_FORKS=4

# ---- web app ----
# Signs the hire-ownership cookie. Required in production: without it the key
# is generated per process, so a redeploy stops recognising every cookie it
# previously issued and each visitor loses the hires they created. Any string
# of 16+ characters.
BENCH_COOKIE_SECRET=
# The worker's health endpoint, read by /status. The worker is a separate
# long-lived process - the one thing a serverless deployment cannot be - so its
# queue state is not in the database and cannot be inferred from the catalog.
# Without this the status page says the worker is unconfigured rather than
# guessing that it is fine.
BENCH_WORKER_HEALTH_URL=

# ---- integrations ----
ALTLAYER_8004SCAN_API_KEY=

# Shared secret for the worker's /health endpoint.
#
# Without it the worker serves status and uptime but WITHHOLDS per-queue
# detail, because a queue's last failure message is written by libraries that
# put connection strings in it - viem embeds the whole archive-node URL, key
# included. Set the same value here and on the web app so the status page can
# show queue detail. Generate with `openssl rand -hex 32`.
BENCH_WORKER_HEALTH_TOKEN=

# Web app only: signs the cookie that owns a hire. REQUIRED in production -
# without it the hire path refuses rather than signing with a per-process key
# that dies at the next restart. Generate with `openssl rand -hex 32`.
BENCH_COOKIE_SECRET=
