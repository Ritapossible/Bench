# ---- chain ----
# BSC testnet while ERC-8183 mainnet is pending. Confirm judging target with organizers.
BENCH_CHAIN=bsc-testnet
# Verified reachable 29 Aug 2026. data-seed-prebsc-1-s1 is dead; publicnode
# serves logs but prunes them after ~11 hours, which is why discovery walks
# token ids instead of scanning registration events.
BSC_TESTNET_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
BSC_MAINNET_RPC_URL=https://bsc-dataseed.bnbchain.org

# The chain auditions FORK, which is not the chain agents register on.
# Identity is on testnet (the mainnet ERC-8004 proxy is an unactivated stub
# with zero agents); markets are on mainnet. An audition replays market
# history, so it forks mainnet and drives agents registered on testnet.
SHADOW_FORK_CHAIN=bsc-mainnet
# Archive node for the shadow engine, and it must serve SHADOW_FORK_CHAIN -
# the worker checks eth_chainId at boot rather than trusting it. A pruned node
# CANNOT serve historical fork state; test a candidate with eth_getStorageAt at
# a block ~200k back, not eth_getCode, which some pruned nodes still answer.
# Optional: without it the worker still indexes and probes, and says on startup
# that auditions are off. With it, the audition queue runs.
BSC_ARCHIVE_RPC_URL=

# ---- ERC-8004 registries (singleton deployments) ----
# BSC testnet (chain 97). Verified on chain: name()="AgentIdentity",
# symbol()="AGENT", 2,013 agents minted since Feb 2026.
ERC8004_IDENTITY_REGISTRY=0x8004a818bfb912233c491871b3d84c89a494bd9e
ERC8004_REPUTATION_REGISTRY=
# Optional. Only probe-digest anchoring uses it, and anchoring also needs
# BENCH_SIGNER_PRIVATE_KEY; without both, the anchor queue stays unregistered
# and the UI says liveness is not yet anchored rather than claiming it is.
ERC8004_VALIDATION_REGISTRY=
# Only used by the log-scanning path. Discovery walks token ids instead, which
# needs no block range at all - see Indexer.enumerationTick.
ERC8004_REGISTRY_START_BLOCK=88400902

# ---- ERC-8183 agentic commerce ----
ERC8183_AGENTIC_COMMERCE=
ERC8183_EVALUATOR_ROUTER=

# ---- x402 ----
X402_FACILITATOR_URL=
# eip3009 | permit2-exact | permit2-upto  (use permit2-upto for metered agents)
X402_DEFAULT_SCHEME=permit2-upto
X402_SETTLEMENT_TOKEN=USDT

# ---- wallet ----
# evm-local | twak | altana   (altana is the only one with EIP-7702 session keys)
BENCH_WALLET_PROVIDER=evm-local
BENCH_SIGNER_PRIVATE_KEY=
ALTANA_API_KEY=

# ---- infra ----
DATABASE_URL=postgresql://bench:bench@localhost:5432/bench
REDIS_URL=redis://localhost:6379

# ---- shadow engine safety ----
# Hard ceiling on real money a single audition may spend on outbound x402 data
# calls. A shadowed agent still makes REAL outbound requests. Without this a
# hundred auditions can bill you for real. See ARCHITECTURE.md 3.3.
SHADOW_EGRESS_BUDGET_USD=0.25
SHADOW_EGRESS_ALLOWLIST=
SHADOW_MAX_CONCURRENT_FORKS=4

# ---- web app ----
# Signs the hire-ownership cookie. Required in production: without it the key
# is generated per process, so a redeploy stops recognising every cookie it
# previously issued and each visitor loses the hires they created. Any string
# of 16+ characters.
BENCH_COOKIE_SECRET=
# The worker's health endpoint, read by /status. The worker is a separate
# long-lived process - the one thing a serverless deployment cannot be - so its
# queue state is not in the database and cannot be inferred from the catalog.
# Without this the status page says the worker is unconfigured rather than
# guessing that it is fine.
BENCH_WORKER_HEALTH_URL=

# ---- integrations ----
ALTLAYER_8004SCAN_API_KEY=

# Shared secret for the worker's /health endpoint.
#
# Without it the worker serves status and uptime but WITHHOLDS per-queue
# detail, because a queue's last failure message is written by libraries that
# put connection strings in it - viem embeds the whole archive-node URL, key
# included. Set the same value here and on the web app so the status page can
# show queue detail. Generate with `openssl rand -hex 32`.
BENCH_WORKER_HEALTH_TOKEN=

# Web app only: signs the cookie that owns a hire. REQUIRED in production -
# without it the hire path refuses rather than signing with a per-process key
# that dies at the next restart. Generate with `openssl rand -hex 32`.
BENCH_COOKIE_SECRET=

# Public origin this worker is reachable at, e.g.
# https://bench-worker.up.railway.app
#
# An audition hands the agent an RPC endpoint and measures what it does with
# it. The interceptor serving that endpoint binds to loopback, because it can
# mint balances - so without a public origin to route through, a registered
# agent cannot reach it, cannot transact, and every measured delta is exactly
# zero whatever the agent would have done. The worker warns loudly at boot
# when auditions are enabled without one.
BENCH_PUBLIC_RPC_BASE_URL=

# Web app only: settle hires on the real ERC-8183 kernel instead of in memory.
#
# Off by default, deliberately. Real escrow moves real $U from an account whose
# admin key this process holds, so a deployment opts into it rather than
# inheriting it from BENCH_SIGNER_PRIVATE_KEY being set for probe anchoring.
# The checkout says which one it is using either way.
BENCH_ESCROW_ENABLED=

# --- Dispute layer: the GenLayer Arbiter -------------------------------------
#
# All three are optional and all three go together. Without the first two the
# dispute layer reports itself unavailable, every write refuses, and the hire
# page says so. There is deliberately no local fallback: a fallback would be
# Bench ruling on disputes about agents Bench lists, ranks and takes a cut of,
# which is the one thing the layer exists to prevent.
#
# Deploy the contract first, on Studio Next (chain 61997):
#   genlayer deploy --contract contracts/genlayer/arbiter.py \
#     --rpc https://studio-next.genlayer.com/api \
#     --args 6 200000 75 15 2 86400 86400 604800 10000000000000000
# The nine arguments are, in order: max_sources, max_source_bytes,
# min_confidence, confidence_tol, max_extensions, extension_period,
# answer_period, claim_period, min_bond.
GENLAYER_RPC_URL=https://studio-next.genlayer.com/api
GENLAYER_ARBITER_ADDRESS=0x21160e3eA4ce08c3f1234884241483aEc1c2c79a
# Which GenLayer network. The RPC URL alone does not say: the SDK needs the
# chain's id and whether it speaks the Studio dialect or drives the consensus
# contract, and a mismatch fails as a malformed call rather than as a
# misconfiguration. One of localnet, studionet, studio-next, studio-devnet,
# testnet-asimov.
GENLAYER_CHAIN=studio-next
# The address hires are registered under. A hire is keyed on
# `<registrar>/<hireId>` so nobody can claim an id they did not create, which
# means a reader has to know the registrar to look one up. Defaults to the
# signing key's own address; set this only for a deployment that reads disputes
# without holding a key, or one whose key has rotated since the hires were made.
GENLAYER_REGISTRAR_ADDRESS=
# The key that pays for arbiter writes. NOT BENCH_SIGNER_PRIVATE_KEY.
#
# That one signs on BSC mainnet: it holds real BNB, it is the wallet provider's
# admin key, and it anchors probe digests to the ERC-8004 Validation Registry -
# the key that could forge Bench's own integrity record. The same secp256k1 key
# is the same address on GenLayer, so sharing one means the devnet gas key IS
# the mainnet key. There is deliberately no fallback: without this the arbiter
# reads and refuses every write, which is visible, rather than quietly signing
# with the wrong key, which is not.
#
# Needs GEN on the arbiter's chain. On Studio Next that is faucet-funded.
GENLAYER_SIGNER_PRIVATE_KEY=
# Bench's own host. Handed to the arbiter so it can mark Bench's data as
# `marketplace` rather than `independent` in the evidence tally - a disclosure
# about our own interest, which is why it is configured rather than taken from
# a request header a caller controls.
GENLAYER_MARKETPLACE_DOMAIN=
# Public origin of this web app, e.g. https://bench-bnb.vercel.app
#
# The action record a dispute is replayed against is published at
# `<origin>/api/hires/<id>/actions`, and that URL is pinned into the hire's
# registration on the arbiter before anyone knows there will be a dispute.
# GenLayer validators fetch it from outside this process, so a relative path or
# a localhost origin makes every breach dispute unresolvable.
BENCH_PUBLIC_WEB_URL=
